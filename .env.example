# ========================================================
# DATABASE ENVIRONMENT VARIABLES
# Used by lib/db.ts to connect to Cloud MySQL / Railway
# ========================================================

# Option 1: Full Connection String (Paste from Railway or TiDB or Cloud DB)
DATABASE_URL=
MYSQL_URL=
MYSQL_PUBLIC_URL=

# Option 2: Individual Connection Parameters
MYSQLHOST=
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=railway

# Railway Public Proxy (if connecting from outside Railway network)
MYSQLHOST_PUBLIC=
MYSQLPORT_PUBLIC=
